diff --git a/lez/wallet/Cargo.toml b/lez/wallet/Cargo.toml
index 9d3f40b..344950e 100644
--- a/lez/wallet/Cargo.toml
+++ b/lez/wallet/Cargo.toml
@@ -19,13 +19,13 @@ testnet_initial_state.workspace = true
 token_core.workspace = true
 vault_core.workspace = true
 bridge_core.workspace = true
-keycard_wallet.workspace = true
+keycard_wallet = { workspace = true, optional = true }
 programs.workspace = true
 system_accounts.workspace = true
 associated_token_account_core.workspace = true
 
 bip39.workspace = true
-pyo3.workspace = true
+pyo3 = { workspace = true, optional = true }
 rpassword = "7"
 zeroize.workspace = true
 aes-gcm.workspace = true
@@ -55,9 +55,13 @@ url.workspace = true
 derive_more = { workspace = true, features = ["display"] }
 
 [features]
+# Keycard (Status hardware wallet) support. OFF by default: it embeds CPython via pyo3,
+# which makes the produced binary hard-link libpython3.X of the BUILD host.
+keycard = ["dep:keycard_wallet", "dep:pyo3"]
+
 # Enables `keycard get-private-keys` command that prints sensitive secret keys to terminal.
 # Never enable in production builds.
-keycard-debug = []
+keycard-debug = ["keycard"]
 
 [dev-dependencies]
 tempfile.workspace = true
