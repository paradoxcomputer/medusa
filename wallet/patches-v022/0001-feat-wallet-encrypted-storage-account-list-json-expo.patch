+    /// Load, transparently decrypting if the file is an encrypted envelope. Returns the
+    /// storage plus the recovery phrase sealed inside it (if any). Plaintext files load
+    /// regardless of `password`; encrypted files need the correct non-empty `password`.
+    pub fn from_path_maybe_encrypted(
+        path: &Path,
+        password: &str,
+    ) -> Result<(Self, Option<String>)> {
+        let bytes = match std::fs::read(path) {
+            Ok(b) => b,
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {
+                anyhow::bail!(
+                    "Storage not found, please setup roots from config command beforehand"
+                );
+            }
+            Err(err) => anyhow::bail!("IO error {err:#?}"),
+        };
+        let persistent: PersistentStorage = if crate::crypto::is_encrypted(&bytes) {
+            let plaintext = crate::crypto::decrypt(&bytes, password)
+                .context("Failed to decrypt wallet storage")?;
+            serde_json::from_slice(&plaintext).context("Failed to parse decrypted storage")?
+        } else {
+            serde_json::from_slice(&bytes).context("Failed to parse storage file")?
+        };
+        let mnemonic = persistent.mnemonic.clone();
+        Ok((Self::from_persistent(persistent)?, mnemonic))
+    }
+
+    /// Save, sealing the file under `password` when it is non-empty (Argon2id + AES-256-GCM
