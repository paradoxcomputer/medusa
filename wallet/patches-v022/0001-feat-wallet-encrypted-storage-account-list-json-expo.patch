+/// Read a hex-encoded signing key for `account import public`.
+///
+/// A command line is world-readable through `/proc/<pid>/cmdline`, so an imported key must
+/// never travel in argv. Stdin line 1 is already the password (read by `main` before any
+/// subcommand runs), so the key is line 2 - the same two-line convention `restore-keys`
+/// uses for the recovery phrase.
+pub fn read_private_key_from_stdin() -> Result<lee::PrivateKey> {
+    let mut hex_key = zeroize::Zeroizing::new(String::new());
+
+    eprint!("Input private key: ");
+    std::io::stderr().flush()?;
+    std::io::stdin().read_line(&mut hex_key)?;
+
+    // The error deliberately omits the offending value: callers log stderr.
+    lee::PrivateKey::from_str(hex_key.trim()).context("Invalid private key")
+}
