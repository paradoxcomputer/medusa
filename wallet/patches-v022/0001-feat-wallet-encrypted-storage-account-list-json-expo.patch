+    pub fn save_to_path_maybe_encrypted(
+        &self,
+        path: &Path,
+        password: &str,
+        mnemonic: Option<&str>,
+    ) -> Result<()> {
+        let mut persistent = self.to_persistent();
+        if !password.is_empty() {
+            persistent.mnemonic = mnemonic.map(ToOwned::to_owned);
+        }
+        let serialized = serde_json::to_vec_pretty(&persistent)?;
+        let bytes = if password.is_empty() {
+            serialized
+        } else {
+            crate::crypto::encrypt(&serialized, password)?
+        };
+        let mut file = std::fs::File::create(path).context("Failed to create file")?;
+        file.write_all(&bytes).context("Failed to write to file")?;
+        file.sync_all().context("Failed to sync file")?;
+        Ok(())
+    }
