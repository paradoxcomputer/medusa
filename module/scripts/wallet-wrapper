#!/usr/bin/env python3
"""Medusa wallet wrapper - normalises wallet-lez output to JSON + adds ergonomics.

The Basecamp wallet module calls `~/.local/bin/wallet` (this script) for every
operation and expects JSON back. wallet-lez prints human-readable text, so this
wrapper adapts it and smooths over a couple of on-chain lifecycle quirks:

  • `account list -l`  → a clean JSON array of the wallet's OWN accounts
                          [{id, type, balance, initialized, label}], dropping the
                          shared "Preconfigured" genesis accounts.
  • `pinata claim`     → auto-registers the recipient first. The faucet program
                          credits without claiming, so the chain rejects an
                          unregistered (default-owned) recipient; we run
                          `auth-transfer init` for it when needed, then claim.
                          Native LEZ only: the token half of a faucet claim is the
                          on-chain medusa_faucet program and is driven by the module,
                          sequenced after this call. See the note further down.
  • `account import`   → the private key is read from stdin (line 2, after the password
                          line), never from argv: /proc/<pid>/cmdline is world-readable.
  • everything else    → JSON passed through; otherwise success text is wrapped as
                          {"ok": true, "output": …} and failures as {"error": …}.

It also sets the wallet home + dev proving mode and seeds a config if missing.
Point $WALLET_LEZ at the real wallet binary; $LOGOS_SEQUENCER at the sequencer.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import time

def _wallet_lez():
    # Find the real wallet binary: $WALLET_LEZ wins; else next to this wrapper (a self-contained
    # bundled install keeps wallet-lez in the same bin/ dir); else the dev-staged ~/.local/bin.
    if os.environ.get("WALLET_LEZ"):
        return os.environ["WALLET_LEZ"]
    here = os.path.dirname(os.path.realpath(__file__))
    bundled = os.path.join(here, "wallet-lez")
    if os.path.isfile(bundled) and os.access(bundled, os.X_OK):
        return bundled
    return os.path.expanduser("~/.local/bin/wallet-lez")


WALLET = _wallet_lez()

home = os.environ.setdefault(
    "LEE_WALLET_HOME_DIR",
    # honor the rc4 name if an old setup still exports it, so plugin + CLI agree on ONE home
    os.environ.get("NSSA_WALLET_HOME_DIR")
    or os.path.expanduser("~/.local/share/medusa-wallet-home"),
)
os.environ.setdefault("RISC0_DEV_MODE", "1")
os.makedirs(home, exist_ok=True)
cfg = os.path.join(home, "wallet_config.json")
if not os.path.exists(cfg):
    with open(cfg, "w") as f:
        json.dump(
            {
                "sequencer_addr": os.environ.get("LOGOS_SEQUENCER", "http://127.0.0.1:3071/"),
                # Confirm window must cover a 60s-block zone (seq-testnet), not just the 15s
                # devnet, or the CLI reports "Transaction not found in preconfigured amount
                # of blocks" for txs that land in the very next block.
                "seq_poll_timeout": "20s",
                "seq_tx_poll_max_blocks": 8,
                "seq_poll_max_retries": 8,
                "seq_block_poll_max_amount": 200,
            },
            f,
        )

# Real STARK proofs (RISC0_DEV_MODE=0) on a busy machine take 20-40+ min (measured on a
# half-loaded 16-core box: native ~20-35 min, token ~40 min). 30 min killed real proofs
# mid-flight, so the budget is 60 min, overridable for slower hardware.
PROOF_TMO = int(os.environ.get("MEDUSA_PROOF_TIMEOUT_S", "3600"))

args = sys.argv[1:]
# The module pipes the session password (+ newline) on stdin; read it once so it can
# be fed to every wallet-lez invocation (some wrapper commands run more than one).
# `account import public` appends a second line, the private key to import.
pw = "" if sys.stdin.isatty() else sys.stdin.read()

# A secret must never reach a command line. /proc/<pid>/cmdline is mode 0444 and a stock
# box mounts /proc with no hidepid, so `--private-key <hex>` hands the key to every local
# uid for as long as the import runs - and this wrapper used to re-exec its argv verbatim,
# putting it on TWO command lines at once. The patched wallet-lez (patches-v020/0003) takes
# the key on stdin line 2 instead, which is what the module now sends. A caller still
# passing --private-key keeps working, but the value is lifted onto stdin here so it never
# reaches the engine's argv. This script's own argv was fixed by whoever exec'd it and
# cannot be rewritten from Python, so that legacy form still leaks on this one process:
# it is kept for backward compatibility only, and callers should stop using it.
if args[:3] == ["account", "import", "public"]:
    _key = ""
    _clean = []
    _drop_next = False
    for _i, _a in enumerate(args):
        if _drop_next:
            _drop_next = False
        elif _a == "--private-key":
            _key = args[_i + 1] if _i + 1 < len(args) else ""
            _drop_next = True
        elif _a.startswith("--private-key="):
            _key = _a.split("=", 1)[1]
        else:
            _clean.append(_a)
    if _key:
        args = _clean
        pw = (pw if pw.endswith("\n") else pw + "\n") + _key + "\n"

# Cap proof parallelism (RISC0/Rayon) EARLY - before any verb block can exec a prover.
# (token-shield/token-deshield emit()+exit inside their blocks and would skip a cap set
# in the passthrough tail.) At full tilt the prover grabs ~all cores for minutes, starves
# the bundled Tor + UI, and the circuit to the sequencer drops ("disconnected from zone")
# → the submit then times out. Leave ~4 cores; explicit env overrides win (setdefault).
_is_privacy = any("Private/" in a for a in args) \
    or (args[:1] and args[0] in ("token-shield", "token-deshield"))
if _is_privacy:
    _ncpu = os.cpu_count() or 4
    os.environ.setdefault("RAYON_NUM_THREADS", str(max(2, _ncpu - 4)))


def run(cmd, timeout=90):
    # A hard timeout so a stuck wallet-lez call (e.g. a token op polling a failed tx)
    # can never hang the whole wrapper command.
    try:
        return subprocess.run([WALLET, *cmd], capture_output=True, text=True, input=pw, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        return subprocess.CompletedProcess(cmd, 124, e.stdout or "", "timed out")
    except OSError as e:
        # The engine is missing, not executable, or its interpreter is gone. This escaped as an
        # unhandled FileNotFoundError, so the caller got a Python traceback on stderr and NO
        # JSON on stdout: the module parses stdout, so a broken install surfaced in the UI as an
        # empty or unparseable reply rather than as the reason. Every other failure in here
        # returns a CompletedProcess, so this one does too.
        return subprocess.CompletedProcess(
            cmd, 127, "", "wallet engine cannot be run (%s): %s" % (WALLET, e))


# ── Token registry (the chain has no holding-enumeration primitive, so we track the
#    token definitions this wallet knows about and probe each with `ata list`). ──
def reg_path():
    # Per-zone registry: tokens are zone-scoped (zone_key() defined below). A bare
    # token_registry.json (legacy) is migrated into the active zone on first use.
    return os.path.join(home, "token_registry-%s.json" % zone_key())


def load_reg():
    # One-time migration: the legacy single-file registry belonged to the default devnet
    # zone - move it there exactly once so it never leaks into other zones.
    legacy = os.path.join(home, "token_registry.json")
    devnet = os.path.join(home, "token_registry-devnet.json")
    if os.path.exists(legacy) and not os.path.exists(devnet):
        try:
            os.rename(legacy, devnet)
        except OSError:
            pass
    try:
        with open(reg_path()) as f:
            r = json.load(f)
        if not isinstance(r, dict):
            raise ValueError("token registry is not a JSON object")
    except FileNotFoundError:
        return {"definitions": [], "names": {}, "vaults": {}, "privateDests": []}
    except (OSError, ValueError):
        # The file EXISTS but does not parse. That is corruption (a torn write, a full disk),
        # NOT a first run, and the two must never look alike: handing back an empty registry
        # here drops every definition, the whole per-owner vault map and the privateDests
        # list, so the faucet would mint a brand-new vault (rebinding its cooldown marker PDA
        # and losing the 6h cooldown) and the one-shot private-recipient guard would go quiet
        # for every private account this wallet has ever paid. Keep a copy for recovery, leave
        # the original in place so the next call fails the same way instead of silently
        # starting over, and refuse loudly.
        if not os.path.exists(reg_path()):
            return {"definitions": [], "names": {}, "vaults": {}, "privateDests": []}
        backup = reg_path() + ".corrupt"
        try:
            with open(reg_path(), "rb") as src, open(backup, "wb") as dst:
                dst.write(src.read())
        except OSError:
            backup = "(copy failed)"
        print(json.dumps({"error":
                          "token registry %s is unreadable (a copy is at %s). Token balances "
                          "and the one-shot private-recipient guard cannot be trusted until it "
                          "is repaired or removed." % (reg_path(), backup)}))
        sys.exit(1)
    r.setdefault("definitions", [])
    r.setdefault("names", {})
    # vaults[owner][definition] = bare id of THAT ACCOUNT's direct holding (shieldable).
    # Old registries used vaults[definition] = holding, one holding per token for the whole
    # wallet, which made the faucet deliver to a single account and made every account show
    # the same token balance. Normalise on read: a holding stands as its own owner, which is
    # true (a direct holding IS one of the wallet's accounts) and keeps existing tokens
    # reachable from the account that actually holds them.
    v = r.get("vaults") or {}
    if v and all(isinstance(x, str) for x in v.values()):
        r["vaults"] = {holding: {defid: holding} for defid, holding in v.items()}
    else:
        r.setdefault("vaults", {})
    # Private accounts we have EVER successfully sent a private OUTPUT to. rc5 rejects a
    # fresh output onto any non-default private account - even a same-def token top-up is
    # silently dropped on-chain AFTER the full client proof (verified live) - so these are
    # one-shot destinations and must never be offered/used again.
    r.setdefault("privateDests", [])
    return r


def save_reg(r):
    # Atomic replace - a claim job and a UI poll can both touch the registry; a torn write
    # would lose the vault map. The scratch name has to be UNIQUE PER WRITER for that to hold:
    # a fixed "<registry>.tmp" is the SAME path for both live wrappers (a background claim job
    # and the 10s UI poll), so both open and truncate one inode, their json.dump bytes
    # interleave in it, and whichever replaces second dies with FileNotFoundError on a tmp that
    # is already gone - after its buffered tail has landed inside the now-live registry. The
    # result parses as garbage, and a registry that will not parse costs the vault map, the
    # faucet cooldown binding and the one-shot privateDests guard. mkstemp hands each writer
    # its own file in the registry's OWN directory, so os.replace stays a same-filesystem
    # rename; fsync first so a crash between write and rename cannot publish a half-filled
    # inode. Two savers can still overwrite each other's last change, but each write is
    # all-or-nothing and the file on disk is always one complete registry.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(reg_path()) or ".",
                               prefix=os.path.basename(reg_path()) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(r, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, reg_path())
    except BaseException:
        # Never leave scratch files behind in the wallet home: a failed save that littered
        # would do it on every 10s poll.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def record_private_dest(dest):
    """Remember a successfully-submitted private OUTPUT destination (one-shot on rc5)."""
    reg = load_reg()
    if dest not in reg["privateDests"]:
        reg["privateDests"].append(dest)
        save_reg(reg)


def submitted(proc):
    """True once the CLI printed a tx hash - the tx is in the sequencer's hands regardless
    of what happens to the confirm poll or this client afterwards."""
    return "transaction hash" in ((proc.stdout or "") + (proc.stderr or "")).lower()


def token_name(reg, defid):
    """Resolve + cache a token definition's human name (definitions are immutable)."""
    if defid in reg["names"]:
        return reg["names"][defid]
    g = run(["account", "get", "--account-id", "Public/" + defid])
    m = re.search(r'"name"\s*:\s*"([^"]+)"', g.stdout or "")
    if not m:
        # Don't cache: a miss here is usually transient (or a zone/binary program-id mismatch,
        # where `account get` silently stops reporting token holdings). Caching the placeholder
        # would pin a wrong ticker forever, since definitions are otherwise immutable.
        return defid[:6] + "…"
    reg["names"][defid] = m.group(1)
    save_reg(reg)
    return m.group(1)


# ── Zone/binary compatibility ────────────────────────────────────────────────────────
# The wallet proves against the risc0 program ImageIDs it was COMPILED with. Point it at a
# zone running a different LEZ build and nothing errors: `account get` stops recognising token
# holdings, so the token verbs below would return empty arrays and zero balances - a silent
# wrong answer. `wallet check-health` compares local ids against the sequencer's getProgramIds
# and asserts, so any non-zero exit means "incompatible". Cached per process; the module calls
# us once per operation.
_zone_ok = None


def zone_compatible():
    global _zone_ok
    if _zone_ok is None:
        try:
            r = run(["check-health"], timeout=45)
            _zone_ok = (r.returncode == 0)
        except Exception:
            _zone_ok = False
    return _zone_ok


ZONE_MISMATCH = ("this zone runs a different LEZ build than this wallet (program ids differ) - "
                 "switch zone, or install a Medusa built for it")


def require_whole_amount(raw):
    """A positive whole amount, or exit with the JSON error contract.

    LEZ has no decimals, so every amount is a whole number of base units. The three token verbs
    each used to check this differently, and each was wrong in its own way: token-deshield did
    not check at all and only found out after a 900s private sync and an on-chain ata create;
    token-transfer parsed to None on a non-integer and then SKIPPED every balance branch,
    sending the raw string on a path whose guards had all been bypassed; token-shield parsed as
    an int but accepted 0 and negatives, which int() is perfectly happy to return. One helper,
    used by all three, so the rule cannot drift again."""
    try:
        n = int(str(raw).strip())
    except (TypeError, ValueError):
        print(json.dumps({"error": "amount must be a whole number"})); sys.exit(1)
    if n <= 0:
        print(json.dumps({"error": "amount must be greater than zero"})); sys.exit(1)
    return n


# ── THE CLIENT-SIDE TOKEN FAUCET IS GONE ───────────────────────────────────────────────
# `pinata claim` used to do two things: claim native LEZ on-chain, and then have a SEPARATE
# treasury wallet (~/.local/share/medusa-treasury) `token send` a random amount of each
# whitelist token to the claimant. That second half read its whitelist from
# faucet_tokens-<zone>.json inside that treasury directory, and it could never work anywhere
# but the operator's own machine:
#   • the directory is not part of the install. Deleting it (or resetting the wallet, or
#     installing on a second machine) silently removed the tokens from every claim while the
#     LEZ half kept succeeding, which is exactly how the bug presented: "I claimed the faucet
#     and got LEZ but no tokens", with nothing in any log to say why.
#   • it needed the treasury's PRIVATE KEYS locally, so on a remote zone a user could not have
#     run it even with the file: you cannot spend a supply account you do not hold.
# The replacement is on-chain: the deployed `medusa_faucet` program owns its treasuries as PDAs
# and dispenses from them itself. The module drives it with medusa-faucet-client
# (WalletPlugin::startTokenFaucet), so no token distribution happens in this wrapper at all.
# `bootstrap-treasury.sh` stays, as the operator tool that MINTS and funds those treasuries.


def active_seq():
    """The sequencer the user wallet is currently pointed at (per the active network)."""
    try:
        with open(os.path.join(home, "wallet_config.json")) as f:
            return json.load(f).get("sequencer_addr", "http://127.0.0.1:3071/")
    except (OSError, ValueError):
        return os.environ.get("LOGOS_SEQUENCER", "http://127.0.0.1:3071/")


def active_port():
    m = re.search(r":(\d+)", active_seq())
    return m.group(1) if m else "3071"


def zone_key():
    """A stable per-zone key for scoping the token registry. The module writes the active
    zone id into wallet_config.json; fall back to the sequencer port (so older per-port
    registries keep working)."""
    try:
        with open(os.path.join(home, "wallet_config.json")) as f:
            z = json.load(f).get("zone")
        if z:
            return re.sub(r"[^A-Za-z0-9_.-]", "_", str(z))
    except (OSError, ValueError):
        pass
    return active_port()


def ata_balance(user_bare, defb):
    """Current balance of the user's ATA for a definition, or None if the ATA is absent."""
    res = run(["ata", "list", "--owner", user_bare, "--token-definition", defb])
    m = re.search(r"\bbalance\s*(\d+)", res.stdout or "")
    return int(m.group(1)) if m else None


def poll_ata(user_bare, defb, predicate, timeout=150):
    """Poll the user's ATA until `predicate(balance)` holds (block time can exceed the
    CLI's tx-poll window, so dependent txs must wait for the state, not just rc=0).
    The default window covers two 60s blocks with margin."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        bal = ata_balance(user_bare, defb)
        if predicate(bal):
            return bal
        time.sleep(3)
    return ata_balance(user_bare, defb)


def emit(proc):
    out = (proc.stdout or "").strip()
    try:
        json.loads(out)
        print(out)
    except (json.JSONDecodeError, ValueError):
        if proc.returncode != 0:
            msg = (proc.stderr or "").strip() or out or f"wallet command failed (exit {proc.returncode})"
            msg = msg.replace("Input password: ", "").replace("Input recovery phrase: ", "")
            msg = msg.replace("Input private key: ", "").strip()
            print(json.dumps({"error": msg}))
        else:
            print(json.dumps({"ok": True, "output": out}))
    sys.exit(proc.returncode)


def id_arg():
    # BOTH spellings. clap accepts `--to X` and `--to=X` alike, so a scan that only knew the
    # separated form silently returned None for the joined one: the one-shot private-recipient
    # guard and the pre-send private sync both key off this, and both would quietly skip on a
    # `--to=Private/...` the engine went on to execute. The module always emits the separated
    # form, but the wrapper is a CLI in its own right and passes user argv through verbatim.
    for i, a in enumerate(args):
        if a in ("--to", "--account-id") and i + 1 < len(args):
            return args[i + 1]
        for flag in ("--to=", "--account-id="):
            if a.startswith(flag):
                return a[len(flag):]
    return None


# ── Token privacy (shield / deshield) ────────────────────────────────────────
def owned_accounts():
    """The wallet's own accounts as rc5's `account list --json` array (or [])."""
    res = run(["account", "list", "--json"], timeout=45)
    try:
        a = json.loads((res.stdout or "").strip())
        return a if isinstance(a, list) else []
    except (json.JSONDecodeError, ValueError):
        return []


def private_dest_block(dest):
    """LEZ v0.2.0 rejects a private OUTPUT onto any non-default private account: the
    native circuit guest-panics client-side, and a token output (even SAME-def) proves
    fine locally but is silently dropped on-chain (verified live - vault balance never
    moved). Refuse early. Two signals: our registry of past private destinations (catches
    token-note accounts the native `account list` can't see), and the account list's
    initialized/balance for native state. Foreign destinations pass through."""
    if not dest.startswith("Private/"):
        return None
    if dest in (load_reg().get("privateDests") or []):
        return ("this private account already received a private transfer - LEZ v0.2.0 "
                "private accounts are one-shot recipients; create a fresh private account")
    for a in owned_accounts():
        if a.get("id") == dest and (a.get("initialized") or (a.get("balance") or 0) > 0):
            return ("recipient private account already holds funds/state - LEZ v0.2.0 "
                    "requires an EMPTY private recipient; create a fresh private account")
    return None


def _faucet_client():
    """medusa-faucet-client, beside the engine on a bundled install, else the dev-staged one."""
    env = os.environ.get("MEDUSA_FAUCET_CLIENT")
    if env:
        return env
    beside = os.path.join(os.path.dirname(os.path.realpath(WALLET)), "medusa-faucet-client")
    if os.path.isfile(beside) and os.access(beside, os.X_OK):
        return beside
    return os.path.expanduser("~/.local/bin/medusa-faucet-client")


def run_faucet_client(cmd, timeout=300):
    """Same stdin-password convention as the engine, so `run`'s contract carries over."""
    try:
        return subprocess.run([_faucet_client(), *cmd], capture_output=True, text=True,
                              input=pw, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        return subprocess.CompletedProcess(cmd, 124, e.stdout or "", "timed out")
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", "faucet client cannot be run: %s" % e)


def bootstrap_holding(owner, defb):
    """Create and INITIALIZE a keytree holding of `defb` for `owner`, returning its bare id.

    A shield proves spend authority from a signing key, so its source must be a keytree
    account. An ATA is a PDA and never qualifies, and nothing can bootstrap a holding from
    ATA funds on its own: the token program initializes an uninitialized recipient only when
    that recipient is AUTHORIZED, and `ata send` passes its recipient unauthorized (verified
    in the wallet's own ata facade). So the account is minted here and initialized through
    medusa-faucet-client's `init-holding`, which sends token::InitializeAccount with the
    holding signed. Returns None if anything fails, and the caller reports the usual error.
    """
    made = run(["account", "new", "public"])
    m = re.search(r"account_id\s+(?:Public/)?([1-9A-HJ-NP-Za-km-z]{32,44})", made.stdout or "")
    if not m:
        return None
    bare = m.group(1)
    res = run_faucet_client(["init-holding", "--definition", defb, "--holding", bare])
    try:
        out = json.loads((res.stdout or "").strip())
    except (json.JSONDecodeError, ValueError):
        return None
    if not out.get("ok"):
        return None
    reg = load_reg()
    reg.setdefault("vaults", {}).setdefault(owner, {})[defb] = bare
    save_reg(reg)
    return bare


def direct_holding_for(defb, need):
    """Find a direct-owned PUBLIC token-holding account of `defb` with balance >= need.
    (A holding whose key IS in the keytree - e.g. a supply account from `token new`.
    ATAs don't qualify: they are PDAs and cannot sign a private send.)
    Returns (bare_id, None) on success, else (None, best_short_balance | None) so the
    caller can tell "no holding at all" from "holding exists but short"."""
    best = None
    for h in direct_holdings_list():
        if h["definitionId"] != defb:
            continue
        bal = int(h["balance"])
        if bal >= need:
            return h["account"], None
        best = bal if best is None else max(best, bal)
    return None, best


def holding_state(bare):
    """(definition_id, balance) if the account is a DIRECT token holding; ("", None) if
    pristine/uninitialized (claimable by the token program on first credit); (None, None)
    otherwise (another program's account / unreadable)."""
    g = run(["account", "get", "--account-id", "Public/" + bare])
    out = g.stdout or ""
    if g.returncode != 0 and not out.strip():
        return "?", None   # transient read failure - callers keep any prior designation
    m = re.search(r'"definition_id"\s*:\s*"([^"]+)"\s*,\s*"balance"\s*:\s*(\d+)', out)
    if "owned by token program" in out and m:
        return m.group(1), int(m.group(2))
    if "Uninitialized" in out:
        return "", None
    return None, None


def poll_holding(bare, defb, predicate, timeout=150):
    """Poll a direct holding's balance (None while not a holding of defb yet). The window
    covers two 60s blocks with margin, like poll_ata."""
    deadline = time.time() + timeout
    val = None
    while time.time() < deadline:
        d, b = holding_state(bare)
        val = b if d == defb else None
        if predicate(val):
            return val
        time.sleep(3)
    return val


def direct_holdings_list():
    """All DIRECT-owned token holdings: [{definitionId, ticker, balance, account}]."""
    reg = load_reg()
    out = []
    for a in owned_accounts():
        if (a.get("type") or "public") != "public":
            continue
        bare = (a.get("id") or "").split("/")[-1]
        if not bare:
            continue
        d, b = holding_state(bare)
        if d:
            out.append({"definitionId": d, "ticker": token_name(reg, d),
                        "balance": str(b), "account": bare})
    return out


def vault_for(defb, owner=None):
    """THIS ACCOUNT's designated DIRECT holding for a definition (registry-recorded; the
    faucet delivers there so tokens arrive SHIELDABLE). Never mints one: a pristine account
    can only be claimed by a SAME-WALLET `token send` from a direct holding (cross-wallet
    credits to pristine accounts are rejected on-chain - the claim needs the recipient key's
    co-signature), so a wallet without a direct holding cannot bootstrap a vault.
    Returns the bare id, or None.

    `owner` is the account the tokens belong to. Vaults are per-owner: without this, one
    holding served the whole wallet, so the faucet always paid the same account and every
    other account showed a balance it could not spend. With no owner given, fall back to the
    wallet-wide scan for callers that genuinely have no account in hand."""
    reg = load_reg()
    vaults = reg.get("vaults") or {}
    bare = (vaults.get(owner) or {}).get(defb) if owner else None
    pristine = None
    if bare:
        d, _b = holding_state(bare)
        if d == defb or d == "?":   # real holding of this def, or a transient read failure
            return bare
        if d == "":
            pristine = bare         # recorded but never credited - an INITIALIZED holding
                                    # of this def (scan below) must take precedence, or the
                                    # pristine record shadows real funds forever
    # An owner IS a direct holding when its own on-chain data is a holding of this definition.
    if owner:
        d, _b = holding_state(owner)
        if d == defb:
            reg.setdefault("vaults", {}).setdefault(owner, {})[defb] = owner
            save_reg(reg)
            return owner
    if owner:
        return pristine
    for h in direct_holdings_list():
        if h["definitionId"] == defb:
            reg.setdefault("vaults", {}).setdefault(h["account"], {})[defb] = h["account"]
            save_reg(reg)
            return h["account"]
    return pristine


# `account list [-l]` → rc5's native --json array [{id,type,balance,initialized,label}].
if len(args) >= 2 and args[0] == "account" and args[1] in ("list", "ls"):
    # rc5 emits the clean JSON array directly with --json (balances fetched from the chain).
    # Over a slow zone (diaphani/Tor) give it a generous window; the module calls this async.
    res = run(["account", "list", "--json"], timeout=(45 if zone_key() == "diaphani" else 20))
    out = (res.stdout or "").strip()
    try:
        json.loads(out)            # the wallet emitted the JSON array - pass it through
        print(out)
    except (json.JSONDecodeError, ValueError):
        emit(res)                  # auth failure (wrong password) / unreachable - surface it
    sys.exit(0)

# `token new …` → run it, then record the new definition id so the wallet can show
# holdings of it later (the chain can't enumerate them). The def account stays fresh.
if len(args) >= 2 and args[0] == "token" and args[1] == "new":
    proc = run(args)
    for i, a in enumerate(args):
        if a == "--definition-account-id" and i + 1 < len(args):
            reg = load_reg()
            defid = args[i + 1].split("/")[-1]
            if defid not in reg["definitions"]:
                reg["definitions"].append(defid)
                save_reg(reg)
    emit(proc)

# `tokens <account-id>` (wrapper verb) → JSON array of the account's token holdings
# across every registered definition: [{definitionId, ticker, balance}].
if args and args[0] == "tokens":
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    reg = load_reg()
    owner_bare = (args[1].split("/")[-1] if len(args) > 1 else "")
    holdings = []
    if owner_bare and reg["definitions"]:
        res = run(["ata", "list", "--owner", owner_bare, "--token-definition", *reg["definitions"]])
        balances = {}
        for line in (res.stdout or "").splitlines():
            m = re.match(r"\s*ATA\s+\S+\s+\(definition\s+(\S+)\):\s*balance\s*(\d+)", line)
            if m:
                balances[m.group(1)] = m.group(2)
        # Return EVERY registered token (faucet + manually added). The DESIGNATED vault
        # (direct holding - where the faucet delivers, shieldable) counts toward the
        # balance; the ATA remainder is reported separately so a consolidate can move it.
        #
        # Vaults are per-owner (vaults[owner][definition]), so this account's vault balance is
        # its own and nobody else's. A balance shown against an account must be one that
        # account can actually spend: the old wallet-wide map made every account display the
        # same tokens and imply every account could shield them.
        mine = (reg.get("vaults") or {}).get(owner_bare) or {}
        for defid in reg["definitions"]:
            ata_b = int(balances.get(defid, "0"))
            v_b = 0
            vb = mine.get(defid)
            if vb:
                d, b = holding_state(vb)
                if d == defid:
                    v_b = b
            holdings.append({"definitionId": defid, "ticker": token_name(reg, defid),
                             "balance": str(ata_b + v_b),
                             "ataBalance": str(ata_b), "vaultBalance": str(v_b)})
    print(json.dumps(holdings))
    sys.exit(0)

# NOTE: there is no `whitelist` verb any more. It read faucet_tokens-<zone>.json out of the
# treasury directory, which is operator state outside the install (see the top of this file).
# The curated per-zone token list is a property of the ZONE and now lives in the module's own
# zone table (kFaucetZones in WalletPlugin.cpp); getWhitelist() reads it from there.

# `token-transfer <from-owner> <to-owner> <def> <amount>` → move a token from the sender's
# ATA to the recipient's ATA: derive both ATAs, create the recipient's (permissionless,
# idempotent), token-send from the sender's ATA, and WAIT for the balance to land.
if args and args[0] == "token-transfer" and len(args) >= 5:
    # Same gate token-shield has. Without it a program-id mismatch surfaced as
    # "insufficient token balance": the balance probes read a chain whose token program is a
    # different build, come back 0, and the wallet blames the user's funds for a zone problem.
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    frm = args[1].split("/")[-1]
    to = args[2].split("/")[-1]
    defb = args[3].split("/")[-1]
    amt = args[4]
    # Validated HERE, before the recipient's ATA is created on chain below: a bad amount used
    # to be caught only after that write, so a typo still cost a real transaction.
    amt_n = require_whole_amount(amt)

    def ata_addr(owner):
        r = run(["ata", "address", "--owner", owner, "--token-definition", defb])
        m = re.search(r"([1-9A-HJ-NP-Za-km-z]{40,46})", r.stdout or "")
        return m.group(1) if m else None

    # Ensure the recipient's ATA exists (permissionless, idempotent - the ATA stays the
    # derivable "anyone can pay you" address for foreign recipients), then send: prefer
    # the wallet's DIRECT vault as the source (`token send`, keytree-signed) and fall
    # back to the sender-owner's ATA (`ata send`, owner-authorized - `token send --from
    # <ATA>` fails because the PDA's key isn't in the keytree).
    recip_ata = ata_addr(to)
    if not recip_ata:
        print(json.dumps({"error": "could not derive recipient token account"}))
        sys.exit(1)
    run(["ata", "create", "--owner", "Public/" + to, "--token-definition", defb])
    if poll_ata(to, defb, lambda b: b is not None) is None:
        print(json.dumps({"error": "recipient token account did not appear on-chain - "
                                   "retry in a minute"}))
        sys.exit(1)
    before = ata_balance(to, defb) or 0
    # Spend from the SENDER's own vault: with per-owner vaults there is no single wallet vault
    # to fall back on, and spending someone else's holding is what made every account look
    # like it owned the same tokens.
    v = vault_for(defb, frm)
    vd, vb = holding_state(v) if v else (None, None)
    vault_ok = (vd == defb)
    vb = vb or 0
    ata_src = ata_balance(frm, defb) or 0
    if amt_n is not None and vault_ok and vb >= amt_n:
        snd = run(["token", "send", "--from", "Public/" + v,
                   "--to", "Public/" + recip_ata, "--amount", amt], timeout=300)
    elif amt_n is not None and ata_src >= amt_n:
        snd = run(["ata", "send", "--from", "Public/" + frm,
                   "--token-definition", defb, "--to", recip_ata, "--amount", amt])
    elif amt_n is not None and vault_ok and vb + ata_src >= amt_n:
        # SPLIT balance - the UI advertises ATA+vault as one number, so honor it:
        # consolidate the sender's ATA into the vault first, then send from the vault.
        move = amt_n - vb
        run(["ata", "send", "--from", "Public/" + frm, "--token-definition", defb,
             "--to", v, "--amount", str(move)], timeout=300)
        if poll_holding(v, defb, lambda b: b is not None and b >= vb + move) is None:
            print(json.dumps({"error": "consolidating the split balance did not land - "
                                       "retry in a minute"}))
            sys.exit(1)
        snd = run(["token", "send", "--from", "Public/" + v,
                   "--to", "Public/" + recip_ata, "--amount", amt], timeout=300)
    elif amt_n is not None:
        print(json.dumps({"error": "insufficient token balance: vault %d + ATA %d < %d"
                          % (vb if vault_ok else 0, ata_src, amt_n)}))
        sys.exit(1)
    else:
        snd = run(["ata", "send", "--from", "Public/" + frm,
                   "--token-definition", defb, "--to", recip_ata, "--amount", amt])
    landed = poll_ata(to, defb, lambda b: b is not None and b > before)
    if landed is not None and landed > before:
        print(json.dumps({"ok": True, "output": "sent " + amt}))
        sys.exit(0)
    if submitted(snd):
        # In the sequencer's hands - balances catch up. Reporting an error here invites a
        # UI retry that would DOUBLE-SEND from the vault.
        print(json.dumps({"ok": True, "output": "sent " + amt, "pending": True}))
        sys.exit(0)
    msg = (snd.stderr or snd.stdout or "token transfer did not land").strip()
    print(json.dumps({"error": msg.replace("Input password: ", "").strip()}))
    sys.exit(1)

# `token-shield <from-owner> <to-private> <def> <amount>` → shield tokens into a private
# account. The signing source must be a DIRECT-OWNED token holding (protocol limitation:
# an ATA is a PDA and can't sign, and `ata send` only takes public recipients), so resolve
# one; if the wallet has none, fail with the truth instead of a circuit guest-panic.
# NOTE: <from-owner> is advisory (kept for the module's job record) - holdings are
# wallet-global, so the ACTUAL debited account is the resolved direct holding.
if args and args[0] == "token-shield" and len(args) >= 5:
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    dest = args[2] if args[2].startswith("Private/") else "Private/" + args[2].split("/")[-1]
    defb = args[3].split("/")[-1]
    amt = require_whole_amount(args[4])
    blocked = private_dest_block(dest)
    if blocked:
        print(json.dumps({"error": blocked})); sys.exit(1)
    src, short = direct_holding_for(defb, amt)
    if not src:
        # AUTO-CONSOLIDATE: the vault is short but the requesting owner's ATA may cover
        # the difference - top the vault up with one public ata-send first, so a combined
        # balance still shields in a single user action. The deficit is measured against
        # the VAULT itself (not the largest holding - they differ on issuer wallets).
        owner = args[1].split("/")[-1]
        vault = vault_for(defb, owner)   # this owner's own holding, not the wallet's
        vd, vb = holding_state(vault) if vault else (None, None)
        if vd != defb and (ata_balance(owner, defb) or 0) >= amt:
            # No holding yet, but the ATA covers it. The faucet pays into ATAs and mints
            # nothing, so this is the ordinary case for a user who claimed and then shielded:
            # create the holding ON DEMAND, here, rather than leaving three of them in the
            # account list on the chance somebody eventually shields.
            made = bootstrap_holding(owner, defb)
            if made:
                vault, vd, vb = made, defb, 0
        if vd == defb:
            need = amt - (vb or 0)
            ata_b = ata_balance(owner, defb) or 0
            if 0 < need <= ata_b:
                run(["ata", "send", "--from", "Public/" + owner, "--token-definition", defb,
                     "--to", vault, "--amount", str(need)], timeout=300)
                poll_holding(vault, defb, lambda b: b is not None and b >= (vb or 0) + need)
                src, short = direct_holding_for(defb, amt)
    if not src:
        if short is not None:
            msg = ("your directly-owned holding of this token has only %d - reduce the "
                   "amount (tokens sitting in an ATA can't top it up for shielding on "
                   "LEZ v0.2.0)" % short)
        else:
            msg = ("no directly-owned holding of this token - tokens held in an associated "
                   "token account (ATA) cannot be shielded on LEZ v0.2.0 (an ATA cannot "
                   "sign a private send and `ata send` is public-only); mint or receive the "
                   "token into a direct holding first")
        print(json.dumps({"error": msg})); sys.exit(1)
    res = run(["token", "send", "--from", "Public/" + src, "--to", dest,
               "--amount", str(amt)], timeout=PROOF_TMO)
    if submitted(res):
        record_private_dest(dest)   # one-shot recipient on rc5 - never offer it again
    emit(res)

# `token-deshield <from-private> <to-owner> <def> <amount>` → deshield tokens to the
# recipient owner's ATA: sync the private tree, ensure the ATA exists (permissionless,
# idempotent), then send from the private note to the ATA (proven recipient shape).
if args and args[0] == "token-deshield" and len(args) >= 5:
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    frm = args[1] if args[1].startswith("Private/") else "Private/" + args[1].split("/")[-1]
    to_owner = args[2].split("/")[-1]
    defb = args[3].split("/")[-1]
    # Validated BEFORE the 900s private sync and the on-chain ata create below: this verb used
    # to take the amount on trust, so a typo bought a quarter-hour of syncing and a real
    # transaction before the engine rejected it.
    amt = str(require_whole_amount(args[4]))
    run(["account", "sync-private"], timeout=900)
    run(["ata", "create", "--owner", "Public/" + to_owner, "--token-definition", defb],
        timeout=300)
    if poll_ata(to_owner, defb, lambda b: b is not None) is None:
        # A send to a non-existing holding is REJECTED on-chain - don't burn an hour-long
        # proof on a doomed tx; fail truthfully at the poll window instead.
        print(json.dumps({"error": "recipient token account did not appear on-chain "
                                   "(ata create unconfirmed) - retry in a minute"}))
        sys.exit(1)
    addr = run(["ata", "address", "--owner", to_owner, "--token-definition", defb])
    m = re.search(r"([1-9A-HJ-NP-Za-km-z]{40,46})", addr.stdout or "")
    if not m:
        print(json.dumps({"error": "could not derive recipient token account"})); sys.exit(1)
    emit(run(["token", "send", "--from", frm, "--to", "Public/" + m.group(1),
              "--amount", amt], timeout=PROOF_TMO))

# `direct-holdings` (wrapper verb) → the wallet's DIRECT-owned token holdings (keytree-
# signable, e.g. supply accounts from `token new`): [{definitionId, ticker, balance,
# account}]. These are the only accounts that can SOURCE a token shield on rc5 - the UI's
# shield asset picker is fed from this, so it never offers un-shieldable ATA balances.
if args and args[0] == "direct-holdings":
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    reg = load_reg()
    out = direct_holdings_list()
    # Per-def ATA totals across owned public accounts - the "unshielded" remainder a
    # consolidate (or the token-shield auto-top-up) can move into the vault.
    defs = sorted({h["definitionId"] for h in out} | set(reg["definitions"]))
    ata_tot = {}
    if defs:
        for a in owned_accounts():
            if (a.get("type") or "public") != "public":
                continue
            bare = (a.get("id") or "").split("/")[-1]
            if not bare:
                continue
            res = run(["ata", "list", "--owner", bare, "--token-definition", *defs])
            for line in (res.stdout or "").splitlines():
                m = re.match(r"\s*ATA\s+\S+\s+\(definition\s+(\S+)\):\s*balance\s*(\d+)", line)
                if m:
                    ata_tot[m.group(1)] = ata_tot.get(m.group(1), 0) + int(m.group(2))
    for h in out:
        h["ataTotal"] = str(ata_tot.get(h["definitionId"], 0))
    print(json.dumps(out))
    sys.exit(0)

# `consolidate <owner> <def>` (wrapper verb) → move the owner's ATA balance of a token
# into the wallet's direct vault holding, making it SHIELDABLE. The vault must already
# EXIST as a holding (a faucet claim / any direct credit seeds it) - the chain rejects
# ata-sends to non-holding accounts (verified).
if args and args[0] == "consolidate" and len(args) >= 3:
    if not zone_compatible():
        print(json.dumps({"error": ZONE_MISMATCH})); sys.exit(1)
    owner = args[1].split("/")[-1]
    defb = args[2].split("/")[-1]
    bal = ata_balance(owner, defb) or 0
    if bal <= 0:
        print(json.dumps({"error": "no ATA balance of this token to consolidate"})); sys.exit(1)
    # Consolidate moves THIS owner's ATA remainder into THIS owner's own holding. With
    # per-owner vaults there is no wallet-wide vault to sweep into, and sweeping into another
    # account's holding would move the user's tokens somewhere they cannot spend them.
    vault = vault_for(defb, owner)
    if not vault or holding_state(vault)[0] != defb:
        print(json.dumps({"error": "no initialized vault holding for this token yet - claim "
                          "from the faucet (or receive a direct send) once, then retry"}))
        sys.exit(1)
    before = holding_state(vault)[1] or 0
    snd = run(["ata", "send", "--from", "Public/" + owner, "--token-definition", defb,
               "--to", vault, "--amount", str(bal)], timeout=300)
    landed = poll_holding(vault, defb, lambda b: b is not None and b > before)
    if landed is not None and landed > before:
        print(json.dumps({"ok": True, "moved": bal, "vault": vault,
                          "vaultBalance": str(landed)}))
        sys.exit(0)
    if submitted(snd):
        print(json.dumps({"ok": True, "moved": bal, "vault": vault, "pending": True}))
        sys.exit(0)
    msg = (snd.stderr or snd.stdout or "consolidate did not land").strip()
    print(json.dumps({"error": msg.replace("Input password: ", "").strip()})); sys.exit(1)

# `token-registry list` / `token-registry add <def-id>` /
# `token-registry vault <def-id> <bare-account-id>` (wrapper verbs) → manage the set of known
# token definitions (for tokens the user received but didn't mint) and the wallet's designated
# DIRECT holding for each.
if args and args[0] == "token-registry":
    reg = load_reg()
    # `vault` designates an account this wallet owns as the holding for a definition. The
    # on-chain faucet needs one per token before it can claim, and on a wallet that has never
    # held that token there is none to find: the claim path creates the account and records it
    # HERE, so the next claim reuses it. That matters beyond tidiness - the faucet's cooldown
    # marker PDA is derived from the first recipient, so a claim that invented a fresh account
    # each time would derive a fresh marker each time and the 6h cooldown would bind to nothing.
    # `token-registry vault <def-id> <holding> [<owner>]`. Vaults are keyed BY OWNER:
    #     vaults[owner][definition] = holding
    # The old shape was vaults[definition] = holding, ONE holding per token for the whole
    # wallet. That is the bug the owner hit: the faucet always delivered to that single
    # holding no matter which account you claimed from, only that account could shield, and
    # every account displayed the same token balance. A balance shown against an account has
    # to be one that account can actually spend.
    # <owner> defaults to the holding itself, which is what a bare `token-registry vault`
    # from an older caller means and is exactly right for a holding that stands alone.
    if len(args) >= 4 and args[1] == "vault":
        defid = args[2].split("/")[-1]
        bare  = args[3].split("/")[-1]
        owner = (args[4].split("/")[-1] if len(args) >= 5 else bare)
        for v in (defid, bare, owner):
            if not re.fullmatch(r"[1-9A-HJ-NP-Za-km-z]{32,50}", v):
                print(json.dumps({"error": "not a valid account id (expected base58)"}))
                sys.exit(1)
        # Both must be accounts THIS wallet owns: a vault is signed as the claimant on every
        # claim, so recording somebody else's account would produce a tx the chain rejects.
        owned = {(a.get("id") or "").split("/")[-1] for a in owned_accounts()}
        for v in (bare, owner):
            if v not in owned:
                print(json.dumps({"error": "that account is not in this wallet"}))
                sys.exit(1)
        reg.setdefault("vaults", {}).setdefault(owner, {})[defid] = bare
        if defid not in reg["definitions"]:
            reg["definitions"].append(defid)
        save_reg(reg)
        print(json.dumps({"ok": True, "definitionId": defid, "vault": bare, "owner": owner}))
        sys.exit(0)
    if len(args) >= 3 and args[1] == "add":
        defid = args[2].split("/")[-1]
        # 1) format: a base58-encoded 32-byte account id is ~32-44 chars, base58 alphabet.
        if not re.fullmatch(r"[1-9A-HJ-NP-Za-km-z]{32,50}", defid):
            print(json.dumps({"error": "not a valid token id (expected a base58 account id)"}))
            sys.exit(1)
        # 2) existence: the definition account must exist on this zone (best-effort - if the
        #    sequencer can't be reached we don't block, but a definitively-absent id is rejected).
        info = run(["account", "get", "--account-id", "Public/" + defid])
        out = (info.stdout or "") + (info.stderr or "")
        if info.returncode == 0 and "Uninitialized" in out:
            print(json.dumps({"error": "no token with this id exists on this zone"}))
            sys.exit(1)
        if defid not in reg["definitions"]:
            reg["definitions"].append(defid)
            save_reg(reg)
        print(json.dumps({"ok": True, "definitionId": defid}))
        sys.exit(0)
    print(json.dumps({"definitions": reg["definitions"], "names": reg["names"],
                      "vaults": reg.get("vaults", {}),
                      "privateDests": reg.get("privateDests", [])}))
    sys.exit(0)

# ── Recipient registration: the free `auth-transfer init` an outbound transfer may need ──────
#
# THE FAILURE THIS PREVENTS, and it is not an error path - it is a silent one. On LEZ an
# auth-transfer whose recipient is still PRISTINE (default-owned: created locally, never
# registered on-chain) is accepted by the client, submitted, and then dropped at block-build
# time with nothing reported anywhere. The CLI goes on polling seq_tx_poll_max_blocks=8 blocks
# for a transaction that will never land - EIGHT MINUTES on a 60s-block zone - and finally says
# "Transaction not found in preconfigured amount of blocks", which reads like a network fault
# and is not one. The owner hit this sending a Tip Jar tip to a brand-new account.
#
# `auth-transfer init --account-id <id>` puts the record on-chain. It is free, needs no proof
# and is permissionless, which is why `pinata claim` below has always been able to run it for
# ITS recipient - the pinata program credits without claiming, so the chain rejects a credit to
# an account it has no record of. Same on-chain fact, same fix; this is now ONE implementation
# with two callers instead of a trick that only the faucet path knew.
#
# BEST EFFORT, NEVER FATAL. A probe that cannot reach the chain, an unreadable reply, or an
# init that fails leaves the caller exactly where it would have been without this function. It
# can only turn a doomed transfer into a working one, never a working one into a failure.
def ensure_recipient_registered(dest, timeout=180):
    """Register `dest` on-chain iff the chain has no record of it yet. Returns True when an
    init was actually run. Never raises, never blocks the caller's own error handling."""
    if not dest:
        return False
    # 45s, not the default 90s: on a healthy zone this answers in well under a second, and on a
    # zone that cannot answer at all the transfer behind it is doomed anyway - so this is the
    # whole latency the common case (a recipient that already exists) ever pays.
    got = run(["account", "get", "--account-id", dest], timeout=45)
    if "Uninitialized" not in (got.stdout or ""):
        return False        # registered already, or unreadable/transient - proceed either way
    run(["auth-transfer", "init", "--account-id", dest], timeout=timeout)
    return True


# `pinata claim --to <id>` → register the recipient first if the chain has no record of it
# yet (auth-transfer init is free + needs no proof), then claim the native LEZ.
#
# NATIVE LEZ ONLY. The token half of a faucet claim is the on-chain medusa_faucet program,
# driven by the module (startTokenFaucet → medusa-faucet-client), and it is sequenced AFTER
# this call precisely because of the registration below: the pinata program credits an account
# without claiming it, so the chain rejects a credit to an account it has no record of, and
# this is where that record gets created. Nothing here distributes tokens any more; see the
# note at the top of this file for why the treasury-wallet version could not work.
if len(args) >= 2 and args[0] == "pinata" and args[1] == "claim":
    to = id_arg()
    # The claim is a background job (30-min budget in the module), so the per-call cap here
    # is the only artificial limit. Over Tor the init + the pinata PoW/submit/confirm each
    # take a while, so give them generous windows instead of the default 90s.
    if to:
        ensure_recipient_registered(to)
    claim = run(args, timeout=240)
    out = (claim.stdout or "").strip()
    # RESILIENCE: the PoW + tx submission happen BEFORE the confirmation poll. Once a
    # "Transaction hash" is printed the tx is SUBMITTED - the sequencer will commit it
    # regardless of what happens to this client afterwards. So a poll timeout / client
    # disconnect must NOT be reported as failure: the claim "runs in the sequencer".
    ok = (claim.returncode == 0) or submitted(claim)
    if ok:
        res = {"ok": True, "output": out}
        if claim.returncode != 0:
            res["pending"] = True   # submitted but not client-confirmed; the balance catches up
        print(json.dumps(res))
        sys.exit(0)
    msg = (claim.stderr or "").strip() or out or "faucet claim failed"
    print(json.dumps({"error": msg.replace("Input password: ", "").strip()}))
    sys.exit(claim.returncode)

# A private SPEND (sending FROM a Private account: private→private or deshield) proves the
# sender's commitment is in the on-chain tree. If the wallet's local tree is stale, that
# membership proof is built against the wrong root and the sequencer rejects the tx with
# InvalidPrivacyPreservingProof. So auto-sync the private state first (idempotent; the manual
# "sync" button is easy to forget). A shield (--from Public/) needs no sync - it's a new commit.
def _sends_from_private(a):
    for i in range(len(a) - 1):
        if a[i] == "--from" and a[i + 1].startswith("Private/"):
            return True
    return False

# Refuse a private OUTPUT onto a non-default OWNED private account up front - the rc5
# circuit guest-panics on it mid-proof otherwise (applies to shield and private→private,
# native and token alike). Checked BEFORE the sync hook: rejecting a bad destination
# must not cost the caller a multi-minute chain scan first.
if "send" in args:
    # Via id_arg(), which knows both `--to X` and `--to=X`. This used to scan for the separated
    # form inline, so a `--to=Private/...` slipped past the guard and into the engine: the same
    # blind spot the sync hook below already avoided by using id_arg().
    _dest = id_arg()
    if _dest and _dest.startswith("Private/"):
        _blocked = private_dest_block(_dest)
        if _blocked:
            print(json.dumps({"error": _blocked})); sys.exit(1)

# AUTO-REGISTER THE RECIPIENT of an outbound native transfer (see ensure_recipient_registered
# above for the eight-minute silent failure this prevents). Placed here, on the passthrough
# path, so it covers EVERY outbound transfer at once rather than one verb: the Send screen
# (startSendTransfer), the legacy synchronous sendTransfer, a native deshield landing in a
# fresh public account, and a dApp's approved Connect action all reach the CLI as
# `auth-transfer send`. Before the private-state sync below, so a first-time recipient is
# registered before the expensive steps rather than after them.
#
# Scoped deliberately:
#   • auth-transfer ONLY. A token send's recipient is a token holding/ATA, created by
#     `ata create` (see token-transfer/token-deshield above); an auth-transfer record is not
#     what it needs and initialising one would be meaningless.
#   • PUBLIC destinations only. A private destination must stay default-owned - that is
#     precisely what LEZ v0.2.0 requires of a private OUTPUT (see private_dest_block), so
#     initialising one would break the very transfers it was meant to help.
#   • NOT cached between calls. A remembered "already initialized" would be wrong for good the
#     first time a zone is reset (which has happened to this project's own zones) and would
#     fail the way this bug failed: silently, eight minutes at a time. One cheap read per
#     outbound transfer, against an operation that already costs at least one 60s block.
if args[:2] == ["auth-transfer", "send"]:
    _dest = None
    for _i in range(len(args) - 1):
        if args[_i] == "--to":
            _dest = args[_i + 1]
            break
    if _dest and not _dest.startswith("Private/"):
        ensure_recipient_registered(_dest if "/" in _dest else "Public/" + _dest)

if "send" in args and _sends_from_private(args):
    # scan+decrypt → tree matches the chain. A first FULL sync of a mature chain takes
    # minutes (measured 353s on ~2700 blocks), so give it a proper budget.
    run(["account", "sync-private"], timeout=900)

# Everything else: pass JSON through; wrap text as {ok,output} / {error}.
# (The Rayon proof-parallelism cap for privacy ops is applied at startup, near the top.)
# Timeout budget: privacy send = real STARK (up to PROOF_TMO); public send = submit +
# confirm-poll over Tor (+ maybe a recipient init), which can exceed 90s on a slow link;
# a standalone private-state sync scans the whole chain (minutes); everything else 90s.
if "send" in args:
    _tmo = PROOF_TMO if _is_privacy else 300
elif args[:2] == ["account", "sync-private"]:
    _tmo = 900
else:
    _tmo = 90
_res = run(args, timeout=_tmo)
if "send" in args and submitted(_res):
    # A submitted private OUTPUT makes its destination one-shot-used (see
    # private_dest_block) - remember it so it is never offered/used again.
    for _i in range(len(args) - 1):
        if args[_i] == "--to" and args[_i + 1].startswith("Private/"):
            record_private_dest(args[_i + 1])
            break
emit(_res)
